# ─────────────────────────────────────────────
#  Islamic WhatsApp Poster — Environment File
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# Hadith API key — get from https://hadithapi.com
HADITH_API_KEY=your_hadith_api_key_here

# NVIDIA NIM API key — get from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# City and country for prayer times (Aladhan API)
CITY=Rawalpindi
COUNTRY=Pakistan

# Prayer time calculation method (1 = University of Islamic Sciences, Karachi)
PRAYER_METHOD=1
